DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=cocktail
DATABASE_PASSWORD=cocktail_dev_password
DATABASE_NAME=cocktail_taste
# Local Docker/PostgreSQL uses disable. Neon requires require or verify-full.
DATABASE_SSL_MODE=disable
# Lambda defaults to 1; long-running local/Docker execution defaults to 10.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
PORT=3001
