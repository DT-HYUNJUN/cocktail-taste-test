DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=cocktail
DATABASE_PASSWORD=cocktail_dev_password
DATABASE_NAME=cocktail_taste
# Local Docker/PostgreSQL uses disable. Neon requires require or verify-full.
DATABASE_SSL_MODE=disable
# Lambda defaults to 1; long-running local/Docker execution defaults to 10.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
# Production migration/seed commands require a direct endpoint. Local development
# may omit these and falls back to DATABASE_* for Docker compatibility.
MIGRATION_DATABASE_HOST=
MIGRATION_DATABASE_PORT=5432
MIGRATION_DATABASE_USER=
MIGRATION_DATABASE_PASSWORD=
MIGRATION_DATABASE_NAME=
MIGRATION_DATABASE_SSL_MODE=verify-full
MIGRATION_DATABASE_POOL_MAX=1
API_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Optional during a bounded rotation overlap; remove after Vercel switches.
API_HMAC_PREVIOUS_SECRET=
API_HMAC_MAX_AGE_MS=300000
API_MAX_BODY_BYTES=65536
PORT=3001
