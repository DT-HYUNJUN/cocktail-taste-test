{
  "name": "cocktail-taste-test",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && eslint scripts tests",
    "typecheck": "turbo typecheck",
    "test": "turbo test && vitest run --config vitest.tools.config.ts",
    "test:integration": "pnpm --filter api test:integration && pnpm --filter api test:e2e",
    "test:e2e:web": "pnpm --filter web test:e2e",
    "test:architecture": "tsx scripts/check-architecture.ts",
    "package:lambda": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-lambda.ps1",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/backup-postgres.ps1 -RequireEncryption",
    "db:verify-restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/database/verify-local-backup-restore.ps1",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:architecture && pnpm build"
  },
  "devDependencies": {
    "@cocktail-taste-test/eslint-config": "workspace:*",
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "turbo": "^2.5.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
